# ============================================================
# AI Software Engineer Agent Platform - Example Configuration
# Copy this file to .env for local development
# NEVER commit real credentials to version control.
# ============================================================
APP_ENV=development
APP_NAME=ai-software-engineer-agent
DEBUG=true

# Database Configuration (PostgreSQL)
DATABASE_URL=
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=swe_planner_db

# Cache Configuration (Redis)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & JWT Configuration
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Local-First LLM Configuration (Ollama / Free Local)
LLM_PROVIDER=ollama
LLM_MODEL=llama3:latest
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TEMPERATURE=0.2
OLLAMA_REQUEST_TIMEOUT=120.0

# Optional Cloud LLM Providers (Only initialized if keys provided)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=

# GitHub Integration
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_API_BASE_URL=https://api.github.com

# Observability & Tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=swe-agent-platform
SENTRY_DSN=

# Cloud & Infrastructure (Optional/Ready)
AWS_REGION=us-east-1
AWS_ROLE_ARN=

# Release Governance & Quality Thresholds
RELEASE_MIN_QA_SCORE=85.0
RELEASE_MIN_COVERAGE=80.0
RELEASE_MAX_RISK_SCORE=40.0
RELEASE_REQUIRE_HUMAN_APPROVAL=true
PRODUCTION_DEPLOYMENT_ENABLED=false
ROLLBACK_ENABLED=true
HEALTH_CHECK_TIMEOUT=120.0
HEALTH_CHECK_INTERVAL=10.0

# Execution Guards & Quota Limits
MAX_AGENT_ITERATIONS=10
MAX_REPAIR_ATTEMPTS=3
MAX_LLM_TOKENS_PER_REQUEST=6000
MAX_PROJECT_TOKENS_PER_DAY=100000
COST_ALERT_THRESHOLD_USD=1.00
DAILY_COST_LIMIT_USD=5.00
